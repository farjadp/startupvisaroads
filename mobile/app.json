{
  "expo": {
    "name": "VisaRoads",
    "slug": "visaroads",
    "scheme": "visaroads",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F0E9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ashavid.visaroads",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.ashavid.visaroads",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F0E9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#121417",
            "image": "./assets/splash-icon-dark.png"
          },
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 220,
            "backgroundColor": "#F2F0E9",
            "dark": {
              "image": "./assets/splash-icon-android-dark.png",
              "backgroundColor": "#121417"
            }
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fa",
              "fr",
              "zh",
              "ar"
            ],
            "android": [
              "en",
              "fa",
              "fr",
              "zh",
              "ar"
            ]
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ashavid",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2dff448f-8ebe-4479-8c1e-f2b4f5870dd7"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dff448f-8ebe-4479-8c1e-f2b4f5870dd7"
      }
    }
  }
}
