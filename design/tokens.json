{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Visa Roads brand tokens. One source for the site (tailwind.config.ts) and the app (Expo theme). Source of truth for values: the Brand Book in Notion. Change here, never in a consumer.",
  "$version": "1.0.0",
  "$updated": "2026-10-14",

  "color": {
    "paper": { "$type": "color", "$value": "#F2F0E9", "$description": "Page background in paper mode. Warm off-white, never pure white." },
    "ink": { "$type": "color", "$value": "#1A1A1A", "$description": "Text, rules, buttons. Slightly warm black, never pure black." },
    "acid": { "$type": "color", "$value": "#CCFF00", "$description": "The one accent. Highlights, section rules, progress, stamps. Never text on paper (1.03:1)." },
    "night": { "$type": "color", "$value": "#121417", "$description": "Page background in night mode and the dark product canvas." }
  },

  "theme": {
    "$description": "Semantic roles. The app and the site read these, never the raw palette, so a mode switch is one lookup.",
    "paper": {
      "bg": { "$type": "color", "$value": "{color.paper}" },
      "fg": { "$type": "color", "$value": "{color.ink}" },
      "fg-muted": { "$type": "color", "$value": "rgba(26, 26, 26, 0.60)" },
      "fg-faint": { "$type": "color", "$value": "rgba(26, 26, 26, 0.40)" },
      "rule": { "$type": "color", "$value": "rgba(26, 26, 26, 0.15)" },
      "accent": { "$type": "color", "$value": "{color.acid}" },
      "on-accent": { "$type": "color", "$value": "{color.ink}" },
      "button-bg": { "$type": "color", "$value": "{color.ink}" },
      "button-fg": { "$type": "color", "$value": "{color.paper}" }
    },
    "night": {
      "bg": { "$type": "color", "$value": "{color.night}" },
      "fg": { "$type": "color", "$value": "{color.paper}" },
      "fg-muted": { "$type": "color", "$value": "rgba(242, 240, 233, 0.62)" },
      "fg-faint": { "$type": "color", "$value": "rgba(242, 240, 233, 0.42)" },
      "rule": { "$type": "color", "$value": "rgba(242, 240, 233, 0.16)" },
      "accent": { "$type": "color", "$value": "{color.acid}" },
      "on-accent": { "$type": "color", "$value": "{color.ink}" },
      "button-bg": { "$type": "color", "$value": "{color.paper}" },
      "button-fg": { "$type": "color", "$value": "{color.night}" }
    }
  },

  "font": {
    "$description": "Per script. A screen picks the family by the active locale's script, never by locale name, so Arabic (ar) and Persian (fa) share one stack.",
    "latin": {
      "display": { "$type": "fontFamily", "$value": ["DM Serif Display", "Georgia", "serif"], "$description": "Weight 400 only; italic for the second line of a headline. Covers en, fr." },
      "text": { "$type": "fontFamily", "$value": ["Space Grotesk", "system-ui", "sans-serif"], "$description": "Weights 400, 500, 700." }
    },
    "arabic": {
      "display": { "$type": "fontFamily", "$value": ["Estedad", "Vazirmatn", "sans-serif"], "$description": "Weights 700, 900. Self-hosted (SIL OFL). Covers fa, ar." },
      "text": { "$type": "fontFamily", "$value": ["Vazirmatn", "system-ui", "sans-serif"], "$description": "Weights 400, 500, 700. No letter-spacing, no uppercase transforms on this script." }
    },
    "han": {
      "display": { "$type": "fontFamily", "$value": ["Noto Serif SC", "serif"], "$description": "Weights 700, 900. Covers zh. Proposed, not yet approved." },
      "text": { "$type": "fontFamily", "$value": ["Noto Sans SC", "sans-serif"], "$description": "Weights 400, 500, 700. Proposed, not yet approved." }
    }
  },

  "type": {
    "$description": "Sizes in px, line-height unitless. Arabic script takes the larger line-height of each pair.",
    "display-xl": { "$type": "typography", "$value": { "fontSize": 52, "lineHeight": 0.92, "letterSpacing": -0.02, "fontWeight": 400 }, "$description": "Welcome headline." },
    "display-l": { "$type": "typography", "$value": { "fontSize": 40, "lineHeight": 1.0, "letterSpacing": -0.01, "fontWeight": 400 }, "$description": "Screen titles." },
    "display-m": { "$type": "typography", "$value": { "fontSize": 34, "lineHeight": 1.05, "letterSpacing": -0.01, "fontWeight": 400 }, "$description": "Question headline, result title." },
    "display-arabic-xl": { "$type": "typography", "$value": { "fontSize": 36, "lineHeight": 1.25, "letterSpacing": 0, "fontWeight": 900 } },
    "display-arabic-l": { "$type": "typography", "$value": { "fontSize": 30, "lineHeight": 1.3, "letterSpacing": 0, "fontWeight": 900 } },
    "figure": { "$type": "typography", "$value": { "fontSize": 64, "lineHeight": 0.9, "letterSpacing": -0.03, "fontWeight": 400 }, "$description": "A single large number: readiness score, funds amount. Display family." },
    "headline": { "$type": "typography", "$value": { "fontSize": 20, "lineHeight": 1.15, "letterSpacing": 0, "fontWeight": 400 }, "$description": "News item title. Display family." },
    "body": { "$type": "typography", "$value": { "fontSize": 15, "lineHeight": 1.5, "letterSpacing": 0, "fontWeight": 400 } },
    "body-arabic": { "$type": "typography", "$value": { "fontSize": 15, "lineHeight": 1.8, "letterSpacing": 0, "fontWeight": 400 } },
    "row": { "$type": "typography", "$value": { "fontSize": 14, "lineHeight": 1.4, "letterSpacing": 0, "fontWeight": 500 }, "$description": "List rows, checklist items." },
    "caption": { "$type": "typography", "$value": { "fontSize": 12, "lineHeight": 1.5, "letterSpacing": 0, "fontWeight": 400 }, "$description": "Source lines, disclaimers." },
    "label-latin": { "$type": "typography", "$value": { "fontSize": 11, "lineHeight": 1.2, "letterSpacing": 0.15, "fontWeight": 700, "textTransform": "uppercase" }, "$description": "Latin script only." },
    "label-arabic": { "$type": "typography", "$value": { "fontSize": 12, "lineHeight": 1.4, "letterSpacing": 0, "fontWeight": 700 } }
  },

  "space": {
    "$description": "4px scale.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px", "$description": "Screen gutter." },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "14": { "$type": "dimension", "$value": "56px", "$description": "Primary button height." }
  },

  "size": {
    "touch-min": { "$type": "dimension", "$value": "44px" },
    "button": { "$type": "dimension", "$value": "56px" },
    "chip": { "$type": "dimension", "$value": "40px" },
    "row": { "$type": "dimension", "$value": "48px" },
    "icon": { "$type": "dimension", "$value": "20px" },
    "icon-nav": { "$type": "dimension", "$value": "22px" },
    "thumbnail": { "$type": "dimension", "$value": "76px" },
    "rule-accent": { "$type": "dimension", "$value": "3px", "$description": "The acid rule under a heading." },
    "rule-hair": { "$type": "dimension", "$value": "1px" },
    "progress": { "$type": "dimension", "$value": "6px" }
  },

  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Default. Buttons, cards, images, inputs." },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Chips and radio dots only." },
    "mark": { "$type": "dimension", "$value": "6px", "$description": "The app icon and favicon only." }
  },

  "border": {
    "hair": { "$type": "border", "$value": { "width": "1px", "style": "solid", "color": "{theme.paper.rule}" } },
    "strong": { "$type": "border", "$value": { "width": "1px", "style": "solid", "color": "{theme.paper.fg}" } },
    "unearned": { "$type": "border", "$value": { "width": "1px", "style": "dashed", "color": "{theme.paper.fg-faint}" }, "$description": "A badge not yet earned." }
  },

  "motion": {
    "$description": "One curve. Everything off under reduced motion. No bounce, no elastic, nothing scroll-driven that takes the scroll away.",
    "ease": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "duration": {
      "state": { "$type": "duration", "$value": "300ms", "$description": "Small state change, tab switch." },
      "step": { "$type": "duration", "$value": "450ms", "$description": "Stepper, progress fill." },
      "reveal": { "$type": "duration", "$value": "600ms", "$description": "Section reveal, once." },
      "headline": { "$type": "duration", "$value": "700ms", "$description": "Masked word-by-word headline, section rule draw." },
      "zoom": { "$type": "duration", "$value": "26000ms", "$description": "Hero photograph slow zoom." }
    },
    "stagger": { "$type": "duration", "$value": "40ms", "$description": "Per word in a headline; capped at 500ms total." }
  },

  "elevation": {
    "$description": "None. The brand uses rules and fills, not shadows."
  }
}
