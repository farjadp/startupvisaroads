datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   // HTML content
  coverImage  String?
  status      String   @default("DRAFT") // DRAFT or PUBLISHED
  locale      String   @default("en") // en or fa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  tags        Tag[]     @relation("ArticleTags")

  // ─── Autopilot / AIO fields (nullable: hand-written articles leave them empty)
  keyTakeaway   String?   // 40–60 words that answer the article's question outright (answer-engine quote)
  summaryEn     String?   // 2–3 English sentences for GEO, even on fa articles
  faq           String?   // JSON [{q,a}] → FAQPage JSON-LD (falls back to heading extraction when null)
  aiModel       String?
  topicSeed     String?   // why this topic was chosen (planner angle + why_now)
  internalLinks String    @default("[]") // JSON array of site paths linked from the body

  socialPosts   SocialPost[]

  sharedToLinkedin Boolean @default(false)
  sharedToTwitter  Boolean @default(false)
  sharedToFacebook Boolean @default(false)

  @@index([locale, status, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  Article[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  articles  Article[] @relation("ArticleTags")
}

model AiKeyword {
  id        String   @id @default(cuid())
  keyword   String
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, ERROR
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per autopilot invocation, so the admin can see what ran and what failed.
model AutopilotRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  locale     String    @default("en")
  mode       String    @default("planned") // planned | source
  requested  Int
  created    Int       @default(0)
  errors     String?   // JSON [{title?, error}]
  skipped    String?   // JSON [{title, reason}]
  notes      String?

  @@index([startedAt])
}

// Ledger of external articles we have seen, so "n new ones" means something
// across daily runs. `text` is a working input for the fact-sheet step and is
// never published.
model SourceArticle {
  id          String    @id @default(cuid())
  sourceSlug  String
  url         String    @unique
  title       String
  publishedAt DateTime?
  text        String?   // plain text, capped; null until hydrated
  status      String    @default("new") // new | used | skipped | failed
  reason      String?
  articleId   String?   // the Article we wrote from it
  harvestedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sourceSlug, status, publishedAt])
}

model Setting {
  key   String @id
  value String
}

// ─── Marketing ───────────────────────────────────────────────────────────────

model MarketingContact {
  id        String              @id @default(cuid())
  email     String?
  phone     String?
  name      String?
  tags      String              @default("[]") // JSON array of tag strings
  groupId   String?
  group     MarketingGroup?     @relation(fields: [groupId], references: [id])
  createdAt DateTime            @default(now())
  @@index([email])
  @@index([phone])
  @@index([groupId])
}

model MarketingGroup {
  id        String               @id @default(cuid())
  name      String
  color     String               @default("#CCFF00")
  contacts  MarketingContact[]
  campaigns CampaignGroup[]
  createdAt DateTime             @default(now())
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  type        String          @default("EMAIL") // EMAIL | SMS | BOTH
  status      String          @default("DRAFT")  // DRAFT | SCHEDULED | SENDING | DONE | FAILED
  subject     String?
  body        String          @default("")       // HTML for email
  smsBody     String?                            // plain text for SMS
  scheduledAt DateTime?
  sentAt      DateTime?
  groups      CampaignGroup[]
  logs        CampaignLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CampaignGroup {
  campaignId String
  groupId    String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      MarketingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([campaignId, groupId])
}

model CampaignLog {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId   String
  channel     String    // EMAIL | SMS
  status      String    // SENT | FAILED | BOUNCED
  error       String?
  sentAt      DateTime  @default(now())

  // Tracking fields
  openCount   Int       @default(0)
  openedAt    DateTime?
  clickCount  Int       @default(0)
  clickedAt   DateTime?
  clickedUrls String    @default("[]") // JSON list of urls

  @@index([campaignId])
  @@index([campaignId, status])
}

/// One attempt to publish one article to one social destination.
///
/// Three booleans on Article could not express six destinations, could not
/// express "failed, try again tomorrow", and could not answer the question the
/// quiet-day job has to ask: which article have we not posted about lately.
/// This row is also the duplicate guard — the unique constraint is what makes
/// a second send impossible rather than merely unlikely.
model SocialPost {
  id          String   @id @default(cuid())
  /// Null for a post with no article behind it — the standalone knowledge
  /// tweets, which are written from a theme rather than from a page.
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// Destination id from lib/social/destinations.ts, e.g. "telegram-channel".
  destination String
  /// posted | failed | skipped. `skipped` means the destination was not
  /// configured, which is a different thing from a send that failed.
  status      String
  /// Which shape was sent: "article", "insight" or "knowledge".
  kind        String   @default("article")
  /// What a knowledge post was about, so the next one can avoid repeating it.
  topic       String?
  postedAt    DateTime?
  remoteUrl   String?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([articleId, destination, kind])
  @@index([destination, createdAt])
}

// ─── Knowledge sources ───────────────────────────────────────────────────────
// What the admin registers for the writer to draw evidence from. See
// docs/knowledge-sources-architecture.md. A Source is the thing registered
// (a URL, an uploaded PDF, pasted text); a SourceDocument is one concrete
// text we read from it; a SourceChunk is a citable passage with its
// embedding. Nothing in these tables is ever published — it is working input.

model Source {
  id            String    @id @default(cuid())
  kind          String    // html | pdf | youtube | text
  cadence       String    @default("once") // once | watch
  url           String?   @unique
  storagePath   String?   // GCS object path for uploaded PDFs
  title         String?
  trust         String    @default("press") // official | press | commentary
  locale        String?   // en | fa | null
  pinned        Boolean   @default(false)   // digest goes into every prompt on its topics
  topics        String    @default("[]")    // JSON string[]
  watchEvery    Int?      // hours; watch only
  watchMode     String?   // feed | listing | sitemap
  enabled       Boolean   @default(true)
  status        String    @default("pending") // pending | ingesting | ready | blocked | error
  lastCheckedAt DateTime?
  lastError     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  documents     SourceDocument[]
  jobs          IngestJob[]

  @@index([cadence, enabled])
}

model SourceDocument {
  id            String    @id @default(cuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url           String?   @unique
  title         String
  publishedAt   DateTime?
  fetchedAt     DateTime  @default(now())
  contentHash   String
  text          String    // full plain text — working input, never published
  charCount     Int       @default(0)
  language      String?
  digest        String?   // ~300-word fact list, model-written at ingest
  relevance     Int?      // 0–5 vs our keyword list (watch docs)
  matchedTopics String    @default("[]") // JSON string[]
  status        String    @default("new") // new | ready | ignored | used | failed
  reason        String?
  articleIds    String    @default("[]") // JSON string[]
  chunks        SourceChunk[]
  updatedAt     DateTime  @updatedAt

  @@index([sourceId, status, publishedAt])
}

model SourceChunk {
  id          String         @id @default(cuid())
  documentId  String
  document    SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ord         Int
  text        String
  locator     String?        // "p.12" | "00:14:32" | "Eligibility > Funding"
  embedding   Bytes?         // Float32 LE, 1536 dims; null until embedded
  tokenCount  Int            @default(0)

  @@index([documentId, ord])
}

model IngestJob {
  id         String   @id @default(cuid())
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentId String?
  step       String   @default("fetch") // fetch | chunk | embed | digest | done
  status     String   @default("pending") // pending | running | done | failed
  attempts   Int      @default(0)
  error      String?
  runAfter   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, runAfter])
}
